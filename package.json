{
  "name": "@salimshamim/envseal",
  "version": "1.1.1",
  "description": "Encrypt/decrypt .env files for safe git transfer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salimshamim/envseal.git"
  },
  "type": "module",
  "scripts": {
    "test": "mocha \"test/**/*.test.js\"",
    "coverage": "c8 --check-coverage npm test"
  },
  "c8": {
    "all": true,
    "include": [
      "bin/**/*.js"
    ],
    "exclude": [
      "test/**"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "check-coverage": true,
    "lines": 90,
    "functions": 90,
    "statements": 90,
    "branches": 70
  },
  "bin": {
    "envseal": "./bin/cli.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "mocha": "^10.8.2"
  },
  "dependencies": {
    "commander": "^12.0.0"
  }
}
